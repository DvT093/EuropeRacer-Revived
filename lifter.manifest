# MSVC _setjmp3: longjmp (005B4125) springt terug naar het adres na elke aanroep.
setjmp 005B4034 __setjmp3
resume 005B4125  # _longjmp: jmp [jmp_buf.eip] naar het setjmp-terugkeerpunt
replace 00503AB0  # mode select: own 4:3 render size (src/game/gfx_resolution.cpp)

# MSVC C++ EH: _JumpToContinuation (005B0C4E) zet esp/ebp van het frame terug en springt
# naar het adres na het catch-blok. Zonder resume liep die sprong als gewone aanroep terug
# de foutafhandeling in (crash Moskou, 20 nov 2026). Doelen: tools/cxx_continuations.py.
resume 005B0C79  # _JumpToContinuation: jmp eax
